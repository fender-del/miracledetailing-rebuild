{
  "version": 1,
  "docs": [
    {
      "key": "site",
      "label": "Business info",
      "file": "site.json",
      "group": "General",
      "help": "Shown in the header, footer, contact form, map and Google listing on every page.",
      "fields": [
        {
          "name": "name",
          "type": "text",
          "label": "Business name",
          "required": true,
          "max": 60
        },
        {
          "name": "phone",
          "type": "phone",
          "label": "Phone",
          "required": true,
          "help": "International format, e.g. +44 7444 869983. The call and WhatsApp buttons follow this number."
        },
        {
          "name": "email",
          "type": "email",
          "label": "Email",
          "required": true
        },
        {
          "name": "hours",
          "type": "text",
          "label": "Opening hours",
          "max": 80
        },
        {
          "name": "address",
          "type": "group",
          "label": "Address",
          "fields": [
            {
              "name": "unit",
              "type": "text",
              "label": "Unit / building",
              "required": true
            },
            {
              "name": "street",
              "type": "text",
              "label": "Street",
              "required": true
            },
            {
              "name": "town",
              "type": "text",
              "label": "Town",
              "required": true
            },
            {
              "name": "county",
              "type": "text",
              "label": "County"
            },
            {
              "name": "postcode",
              "type": "text",
              "label": "Postcode",
              "required": true,
              "max": 10
            }
          ]
        },
        {
          "name": "rating",
          "type": "text",
          "label": "Google rating",
          "max": 3,
          "help": "From your Google Business Profile, e.g. 5.0"
        },
        {
          "name": "reviewCount",
          "type": "number",
          "label": "Number of Google reviews",
          "min": 0
        },
        {
          "name": "reviewsUrl",
          "type": "url",
          "label": "Link to your Google reviews"
        },
        {
          "name": "vatMode",
          "type": "select",
          "label": "Show prices",
          "options": [
            {
              "value": "ex",
              "label": "Excluding VAT (+ VAT)"
            },
            {
              "value": "inc",
              "label": "Including VAT"
            }
          ]
        },
        {
          "name": "instagram",
          "type": "group",
          "label": "Instagram",
          "fields": [
            {
              "name": "handle",
              "type": "text",
              "label": "Handle"
            },
            {
              "name": "href",
              "type": "url",
              "label": "Profile link"
            }
          ]
        },
        {
          "name": "waChat",
          "type": "group",
          "label": "WhatsApp chat bubble",
          "fields": [
            {
              "name": "caption",
              "type": "text",
              "label": "Reply time",
              "max": 50
            },
            {
              "name": "hello",
              "type": "text",
              "label": "Greeting",
              "max": 40
            },
            {
              "name": "ask",
              "type": "text",
              "label": "Question",
              "max": 60
            }
          ]
        },
        {
          "name": "origin",
          "type": "url",
          "label": "Live web address",
          "agencyOnly": true,
          "help": "Used for canonical links, the sitemap and Google listings."
        },
        {
          "name": "preview",
          "type": "boolean",
          "label": "Pre-launch: hide the whole site from Google",
          "agencyOnly": true
        }
      ]
    },
    {
      "key": "services",
      "label": "Services & prices",
      "file": "services.json",
      "group": "General",
      "help": "The service cards on the home page and the Services page. Prices are plain numbers; the site adds £ and VAT.",
      "path": "/car-care-services/",
      "fields": [
        {
          "name": "services",
          "type": "list",
          "label": "Service cards",
          "itemLabel": "name",
          "itemName": "service",
          "fields": [
            {
              "name": "name",
              "type": "text",
              "label": "Name",
              "required": true,
              "max": 40
            },
            {
              "name": "line",
              "type": "text",
              "label": "One-line description",
              "max": 70
            },
            {
              "name": "badge",
              "type": "text",
              "label": "Small label",
              "max": 40
            },
            {
              "name": "from",
              "type": "price",
              "label": "From price (ex. VAT)",
              "min": 0
            },
            {
              "name": "per",
              "type": "select",
              "label": "Price is per",
              "options": [
                {
                  "value": "hour",
                  "label": "Hour"
                }
              ]
            },
            {
              "name": "fromNote",
              "type": "text",
              "label": "What the price covers",
              "max": 60
            },
            {
              "name": "poa",
              "type": "boolean",
              "label": "Show \"Price POA\" instead of a price"
            },
            {
              "name": "quote",
              "type": "boolean",
              "label": "Show \"Enquire for a Bespoke Quotation\""
            },
            {
              "name": "alt",
              "type": "text",
              "label": "Photo description (alt text)",
              "max": 125
            }
          ]
        },
        {
          "name": "serviceGroups",
          "type": "list",
          "label": "Services menu",
          "itemLabel": "name",
          "itemName": "menu group",
          "help": "The Services menu and footer. Renaming a service card does not rename it here: menu names can differ on purpose (e.g. \"Ceramic Coatings\").",
          "fields": [
            {
              "name": "name",
              "type": "text",
              "label": "Group name",
              "required": true,
              "max": 30
            },
            {
              "name": "links",
              "type": "list",
              "label": "Links",
              "itemLabel": "name",
              "itemName": "link",
              "fields": [
                {
                  "name": "name",
                  "type": "text",
                  "label": "Name",
                  "required": true,
                  "max": 40
                },
                {
                  "name": "href",
                  "type": "url",
                  "label": "Page",
                  "required": true
                }
              ]
            }
          ]
        }
      ]
    },
    {
      "key": "reviews",
      "label": "Reviews",
      "file": "reviews.json",
      "group": "General",
      "help": "The Google reviews shown above the booking form.",
      "fields": [
        {
          "name": "reviews",
          "type": "list",
          "label": "Reviews",
          "itemLabel": "name",
          "itemName": "review",
          "fields": [
            {
              "name": "text",
              "type": "textarea",
              "label": "Review",
              "required": true,
              "max": 400
            },
            {
              "name": "name",
              "type": "text",
              "label": "Name",
              "required": true,
              "max": 40
            },
            {
              "name": "car",
              "type": "text",
              "label": "Car or source",
              "max": 40
            },
            {
              "name": "initials",
              "type": "text",
              "label": "Initials (avatar)",
              "max": 3
            }
          ]
        }
      ]
    },
    {
      "key": "faqs",
      "label": "FAQs",
      "file": "faqs.json",
      "root": "list",
      "group": "General",
      "path": "/car-detail-faqs/",
      "fields": [
        {
          "name": "sections",
          "type": "list",
          "label": "Sections",
          "itemLabel": "title",
          "itemName": "section",
          "fields": [
            {
              "name": "title",
              "type": "text",
              "label": "Section title",
              "required": true,
              "max": 40
            },
            {
              "name": "items",
              "type": "list",
              "label": "Questions",
              "itemLabel": "q",
              "itemName": "question",
              "fields": [
                {
                  "name": "q",
                  "type": "text",
                  "label": "Question",
                  "required": true,
                  "max": 120
                },
                {
                  "name": "a",
                  "type": "richtext",
                  "label": "Answer",
                  "required": true
                }
              ]
            }
          ]
        }
      ]
    },
    {
      "key": "form",
      "label": "Booking form choices",
      "file": "form.json",
      "group": "General",
      "fields": [
        {
          "name": "formServices",
          "type": "list",
          "of": "text",
          "label": "\"What would you like done?\" choices"
        },
        {
          "name": "heardFrom",
          "type": "list",
          "of": "text",
          "label": "\"How did you hear about us?\" choices"
        }
      ]
    },
