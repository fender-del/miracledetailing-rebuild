// Cloudflare Workers: the built site in ./site as static assets, plus one
// script (worker/index.js) that runs only for /api/* (the booking form).
// _headers and _redirects in ./site apply to every other path as before.
// Secrets RESEND_API_KEY and TURNSTILE_SECRET are set in the dashboard
// (Settings -> Variables and Secrets), never here. BOOK_TO and BOOK_FROM
// live in "vars" below (16/11): `wrangler deploy` replaces the Worker's
// plain variables with this file's, so ones typed in the dashboard would
// be wiped on every push. Secrets are kept.
{
  "name": "miracle-detail-rebuild",
  "compatibility_date": "2026-10-01",
  "main": "./worker/index.js",
  "assets": {
    "directory": "./site",
    "binding": "ASSETS",
    "html_handling": "auto-trailing-slash",
    // 16/11: a path with no page and no 301 gets site/404.html (built by build.js)
    "not_found_handling": "404-page",
    "run_worker_first": ["/api/*"]
  },
  "vars": {
    // Live since 18/11: Paul's inbox. For a test, point it at your own inbox and push.
    "BOOK_TO": "info@miracledetail.co.uk",
    "BOOK_FROM": "Miracle Detail website <booking@send.miracledetail.co.uk>"
  },
  // Branch builds run `npx wrangler preview`, which needs this block (it may stay empty).
  "previews": {},
  "observability": {
    "logs": { "enabled": true, "head_sampling_rate": 1, "invocation_logs": true, "persist": true },
    "traces": { "enabled": false, "head_sampling_rate": 1, "persist": true }
  }
}
