// Cloudflare Workers: the built site in ./site as static assets, plus one
// script (worker/index.js) that runs only for /api/* (the booking form).
// _headers and _redirects in ./site apply to every other path as before.
// Secrets RESEND_API_KEY, TURNSTILE_SECRET and vars BOOK_TO, BOOK_FROM are
// set in the dashboard (Settings -> Variables and Secrets), never here.
{
  "name": "miracle-detail-rebuild",
  "compatibility_date": "2026-10-01",
  "main": "./worker/index.js",
  "assets": {
    "directory": "./site",
    "binding": "ASSETS",
    "html_handling": "auto-trailing-slash",
    "run_worker_first": ["/api/*"]
  },
  // Branch builds run `npx wrangler preview`, which needs this block (it may stay empty).
  "previews": {},
  "observability": {
    "logs": { "enabled": true, "head_sampling_rate": 1, "invocation_logs": true, "persist": true },
    "traces": { "enabled": false, "head_sampling_rate": 1, "persist": true }
  }
}
